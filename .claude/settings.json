{
  "$comment": "Committed project-level agent config. Personal overrides go in .claude/settings.local.json (gitignored). See .claude/README.md.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/refresh-symbol-index.sh"
          }
        ]
      }
    ]
  },
  "$permissionsComment": "Running anything IN this project is pre-approved: every script under scripts/, the test suite, the linters, and the ./iwanttoplay launcher, in either shell. These replaced a per-script enumeration that had to be extended every time a generator was added. NOT covered, deliberately: inline code (python -c, python -), which is arbitrary execution rather than running a project file, and anything that reaches outside the repo.",
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "Bash(python ./scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(py scripts/*)",
      "Bash(./iwanttoplay)",
      "Bash(./iwanttoplay:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff check:*)",
      "Bash(ruff check:*)",
      "Bash(luacheck:*)",
      "PowerShell(python scripts/*)",
      "PowerShell(python ./scripts/*)",
      "PowerShell(python3 scripts/*)",
      "PowerShell(py scripts/*)",
      "PowerShell(./iwanttoplay)",
      "PowerShell(./iwanttoplay:*)",
      "PowerShell(python -m pytest:*)",
      "PowerShell(python -m ruff check:*)",
      "PowerShell(ruff check:*)",
      "PowerShell(luacheck:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Read(./.claude/settings.local.json)"
    ]
  }
}
