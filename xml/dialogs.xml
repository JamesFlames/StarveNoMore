<!-- dialogs.xml — modal / situational panels: confirm, end-of-day summary,
     Week in Review, Help, trade + signature target pickers, rest choice,
     combat press window, and the Dusk scramble bar. -->

<!-- ================================================================== -->
<!-- G.6  CONFIRM DIALOG — modal for resource-spending actions          -->
<!-- Design §18.14: costs visible before commitment                     -->
<!-- ================================================================== -->
<Panel id="confirmDialog"
       rectAlignment="MiddleCenter"
       width="440" height="200"
       color="#0A0A0AEB"
       outline="#C8C86480"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="8" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text id="confirmTitle" fontSize="20" fontStyle="Bold" color="#FFDD88"
          text="Confirm Action" preferredHeight="28" />
    <Text id="confirmBody" fontSize="15" color="#CCCCCC"
          text="Cost: ???&#10;You have: ???"
          preferredHeight="60" />
    <HorizontalLayout spacing="20" childForceExpandWidth="true"
                      preferredHeight="44">
      <Button id="confirmYes"
              onClick="onConfirmYes"
              fontSize="18" fontStyle="Bold"
              color="#1E501EE6" textColor="#88FF88"
              text="Confirm" />
      <Button id="confirmNo"
              onClick="onConfirmNo"
              fontSize="18"
              color="#501E1EE6" textColor="#FF8888"
              text="Cancel" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- I.4  END-OF-ROUND SUMMARY — auto-dismiss panel after Tick          -->
<!-- Stubbed here, populated by Lua in Phase I                          -->
<!-- ================================================================== -->
<Panel id="summaryPanel"
       rectAlignment="MiddleCenter"
       width="660" height="620"
       color="#050A0FF7"
       outline="#50B4DC66"
       outlineSize="2"
       active="false">
