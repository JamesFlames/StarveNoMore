       rectAlignment="MiddleCenter"
       width="380" height="290"
       color="#0A0A0AEB"
       outline="#64B4DC66"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text fontSize="18" fontStyle="Bold" color="#AADDFF"
          text="Pattern Recognition — peek at which deck?" preferredHeight="26" />
    <Text fontSize="12" color="#8899AA" preferredHeight="18"
          text="Free action, once per day. Only you see the answer." />
    <Button id="peekBtn_Phase" onClick="onPeekDeckClick(Phase)"
            fontSize="14" color="#232328E6" textColor="#FFDDAA"
            preferredHeight="34" text="Dawn deck (tomorrow's event)" />
    <Button id="peekBtn_Threat" onClick="onPeekDeckClick(Threat)"
            fontSize="14" color="#2D1E1EE6" textColor="#FFBBBB"
            preferredHeight="34" text="Threat deck (tonight's dangers)" />
    <Button id="peekBtn_Market" onClick="onPeekDeckClick(Market)"
