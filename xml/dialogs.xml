<!-- dialogs.xml — modal / situational panels: confirm, end-of-day summary,
     Week in Review, Help, trade + signature target pickers, rest choice,
     combat press window, and the Dusk scramble bar. -->

<!-- ================================================================== -->
<!-- G.6  CONFIRM DIALOG — modal for resource-spending actions          -->
<!-- Design §18.14: costs visible before commitment                     -->
<!-- ================================================================== -->
<Panel id="confirmDialog"
       rectAlignment="MiddleCenter"
       width="440" height="200"
       color="#0A0A0AEB"
       outline="#C8C86480"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="8" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text id="confirmTitle" fontSize="20" fontStyle="Bold" color="#FFDD88"
          text="Confirm Action" preferredHeight="28" />
    <Text id="confirmBody" fontSize="15" color="#CCCCCC"
          text="Cost: ???&#10;You have: ???"
          preferredHeight="60" />
    <HorizontalLayout spacing="20" childForceExpandWidth="true"
                      preferredHeight="44">
      <Button id="confirmYes"
              onClick="onConfirmYes"
              fontSize="18" fontStyle="Bold"
              color="#1E501EE6" textColor="#88FF88"
              text="Confirm" />
      <Button id="confirmNo"
              onClick="onConfirmNo"
              fontSize="18"
              color="#501E1EE6" textColor="#FF8888"
              text="Cancel" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- I.4  END-OF-ROUND SUMMARY — auto-dismiss panel after Tick          -->
<!-- Stubbed here, populated by Lua in Phase I                          -->
<!-- ================================================================== -->
<Panel id="summaryPanel"
       rectAlignment="MiddleCenter"
       width="600" height="340"
       color="#050A0FEB"
       outline="#50B4DC66"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text id="summaryTitle" fontSize="22" fontStyle="Bold" color="#88DDFF"
          text="End of Day" preferredHeight="28" />
    <Text id="summaryBody" fontSize="14" color="#BBCCDD"
          text=""
          preferredHeight="220" />
    <Button id="summaryClose"
            onClick="onSummaryClose"
            fontSize="16" color="#282828E6" textColor="#AAAAAA"
            preferredHeight="36"
            text="Continue" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- WEEK IN REVIEW — end-of-game chronicle (design_batch1.md §3)       -->
<!-- The week's story, read back: headlines, the darkest night, the     -->
<!-- best kill, who kept everyone fed. Shown at victory or defeat.      -->
<!-- ================================================================== -->
<Panel id="weekReviewPanel"
       rectAlignment="MiddleCenter"
       width="640" height="460"
       color="#08060CF5"
       outline="#DCB45A8C"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="16 16 14 14"
                  childForceExpandHeight="false">
    <Text id="weekReviewTitle" fontSize="22" fontStyle="Bold" color="#FFD080"
          text="THE WEEK" preferredHeight="30" />
    <Text id="weekReviewBody" fontSize="14" color="#DDCCAA"
          text=""
          preferredHeight="330" />
    <Button id="btnCopyLog"
            onClick="onCopySessionLog"
            fontSize="14" color="#192837E6" textColor="#88CCEE"
            preferredHeight="32"
            tooltip="Write this session's telemetry (setup, per-day stats, turn times, batch beats) to the Notes panel as JSON — paste it into the playtest tracker."
            text="Copy Session Log" />
    <Button id="weekReviewClose"
            onClick="onWeekReviewClose"
            fontSize="16" color="#282828E6" textColor="#AAAAAA"
            preferredHeight="38"
            text="Close the book" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- H.3  HELP PANEL — side panel with 5 tabs (Design §18.17)          -->
<!-- ================================================================== -->
<Panel id="helpPanel"
       rectAlignment="MiddleRight"
       offsetXY="-10 0"
       width="400" height="650"
       color="#050A14F0"
       outline="#50B4DC4C"
       outlineSize="1"
       active="false">
  <VerticalLayout spacing="4" padding="10 10 10 10"
                  childForceExpandHeight="false">
    <!-- Tab bar -->
    <HorizontalLayout spacing="4" preferredHeight="32">
      <Button id="helpTabQuick"
              onClick="onHelpTab"
              fontSize="12" color="#14323CE6" textColor="#88DDFF"
              text="Quick Start" />
      <Button id="helpTabChar"
              onClick="onHelpTab"
              fontSize="12" color="#142828CC" textColor="#AACCCC"
              text="Character" />
      <Button id="helpTabDawn"
              onClick="onHelpTab"
              fontSize="12" color="#142828CC" textColor="#AACCCC"
              text="Dawn" />
      <Button id="helpTabDoom"
              onClick="onHelpTab"
              fontSize="12" color="#142828CC" textColor="#AACCCC"
              text="Doom" />
      <Button id="helpTabGlossary"
              onClick="onHelpTab"
              fontSize="12" color="#142828CC" textColor="#AACCCC"
              text="Glossary" />
    </HorizontalLayout>
    <!-- Tab title -->
    <Text id="helpTabTitle" fontSize="16" fontStyle="Bold" color="#88DDFF"
          text="Quick Start" preferredHeight="22" />
    <!-- Tab content -->
    <Text id="helpBody" fontSize="12" color="#BBCCDD"
          text=""
          preferredHeight="530" />
    <!-- Close -->
    <Button id="helpClose"
            onClick="onHelpClose"
            fontSize="14" color="#282828E6" textColor="#AAAAAA"
            preferredHeight="30"
            text="Close" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- TRADE DIALOG — pick a trade partner; costs shown per row.          -->
<!-- Rows populated dynamically by onActTrade (ui_actionbar.lua).       -->
<!-- ================================================================== -->
<Panel id="tradeDialog"
       rectAlignment="MiddleCenter"
       width="380" height="310"
       color="#0A0A0AEB"
       outline="#64B4DC66"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text fontSize="18" fontStyle="Bold" color="#AADDFF"
          text="Trade — choose a partner:" preferredHeight="26" />
    <Text fontSize="12" color="#8899AA" preferredHeight="18"
          text="Exchange the physical tokens/cards after confirming." />
    <Button id="tradeBtn_White" onClick="onTradeTargetClick(White)" active="false"
            fontSize="14" color="#232328E6" textColor="#FFFFFF"
            preferredHeight="34" text="James" />
    <Button id="tradeBtn_Red" onClick="onTradeTargetClick(Red)" active="false"
            fontSize="14" color="#2D1E1EE6" textColor="#FFBBBB"
            preferredHeight="34" text="Coco" />
    <Button id="tradeBtn_Yellow" onClick="onTradeTargetClick(Yellow)" active="false"
            fontSize="14" color="#2D2D19E6" textColor="#FFFFBB"
            preferredHeight="34" text="Rayman" />
    <Button id="tradeBtn_Green" onClick="onTradeTargetClick(Green)" active="false"
            fontSize="14" color="#1E2D1EE6" textColor="#BBFFBB"
            preferredHeight="34" text="Ellie" />
    <Button id="tradeBtn_Blue" onClick="onTradeTargetClick(Blue)" active="false"
            fontSize="14" color="#1E1E32E6" textColor="#BBCCFF"
            preferredHeight="34" text="Luca" />
    <Button id="tradeCancel" onClick="onTradeCancel"
            fontSize="14" color="#321E1EE6" textColor="#FFAAAA"
            preferredHeight="30" text="Cancel" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- SIGNATURE TARGET DIALOG — Coco's Touch of Hope target pick         -->
<!-- Rows populated by showSignatureTargetDialog (signatures.lua).      -->
<!-- ================================================================== -->
<Panel id="signatureTargetDialog"
       rectAlignment="MiddleCenter"
       width="380" height="310"
       color="#0A0A0AEB"
       outline="#DC96F066"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text fontSize="18" fontStyle="Bold" color="#EECCFF"
          text="Touch of Hope — heal who?" preferredHeight="26" />
    <Text fontSize="12" color="#AA88AA" preferredHeight="18"
          text="+4 Health, any tile, any distance. Once per game." />
    <Button id="sigTargetBtn_White" onClick="onSignatureTargetClick(White)" active="false"
            fontSize="14" color="#232328E6" textColor="#FFFFFF"
            preferredHeight="34" text="James" />
    <Button id="sigTargetBtn_Red" onClick="onSignatureTargetClick(Red)" active="false"
            fontSize="14" color="#2D1E1EE6" textColor="#FFBBBB"
            preferredHeight="34" text="Coco" />
    <Button id="sigTargetBtn_Yellow" onClick="onSignatureTargetClick(Yellow)" active="false"
            fontSize="14" color="#2D2D19E6" textColor="#FFFFBB"
            preferredHeight="34" text="Rayman" />
    <Button id="sigTargetBtn_Green" onClick="onSignatureTargetClick(Green)" active="false"
            fontSize="14" color="#1E2D1EE6" textColor="#BBFFBB"
            preferredHeight="34" text="Ellie" />
    <Button id="sigTargetBtn_Blue" onClick="onSignatureTargetClick(Blue)" active="false"
            fontSize="14" color="#1E1E32E6" textColor="#BBCCFF"
            preferredHeight="34" text="Luca" />
    <Button id="sigTargetCancel" onClick="onSignatureCancel"
            fontSize="14" color="#321E1EE6" textColor="#FFAAAA"
            preferredHeight="30" text="Cancel" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- PEEK DIALOG — James's Pattern Recognition (§6.1): pick a deck; the -->
<!-- top card's name is whispered to James alone. Once per day.         -->
<!-- ================================================================== -->
<Panel id="peekDialog"
       rectAlignment="MiddleCenter"
       width="380" height="290"
       color="#0A0A0AEB"
       outline="#64B4DC66"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text fontSize="18" fontStyle="Bold" color="#AADDFF"
          text="Pattern Recognition — peek at which deck?" preferredHeight="26" />
    <Text fontSize="12" color="#8899AA" preferredHeight="18"
          text="Free action, once per day. Only you see the answer." />
    <Button id="peekBtn_Phase" onClick="onPeekDeckClick(Phase)"
            fontSize="14" color="#232328E6" textColor="#FFDDAA"
            preferredHeight="34" text="Dawn deck (tomorrow's event)" />
    <Button id="peekBtn_Threat" onClick="onPeekDeckClick(Threat)"
            fontSize="14" color="#2D1E1EE6" textColor="#FFBBBB"
            preferredHeight="34" text="Threat deck (tonight's dangers)" />
    <Button id="peekBtn_Market" onClick="onPeekDeckClick(Market)"
            fontSize="14" color="#1E2D1EE6" textColor="#BBFFBB"
            preferredHeight="34" text="Market deck (next refill)" />
    <Button id="peekBtn_Visitor" onClick="onPeekDeckClick(Visitor)"
            fontSize="14" color="#1E1E32E6" textColor="#BBCCFF"
            preferredHeight="34" text="Visitor deck" />
    <Button id="peekCancel" onClick="onPeekCancel"
            fontSize="14" color="#321E1EE6" textColor="#FFAAAA"
            preferredHeight="30" text="Cancel" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- RALLY DIALOG — Luca's Rally (§6.5): pick an ally at his tile or    -->
<!-- adjacent; they gain a free non-movement action. Once per turn.     -->
<!-- Rows populated dynamically by onActRally (ui_actionbar.lua).       -->
<!-- ================================================================== -->
<Panel id="rallyDialog"
       rectAlignment="MiddleCenter"
       width="400" height="310"
       color="#0A0A0AEB"
       outline="#DC96B466"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text fontSize="18" fontStyle="Bold" color="#FFCCE5"
          text="Rally — encourage which ally?" preferredHeight="26" />
    <Text fontSize="12" color="#AA8899" preferredHeight="18"
          text="They gain a free non-movement action this Day. Free, once per turn." />
    <Button id="rallyBtn_White" onClick="onRallyTargetClick(White)" active="false"
            fontSize="14" color="#232328E6" textColor="#FFFFFF"
            preferredHeight="34" text="—" />
    <Button id="rallyBtn_Red" onClick="onRallyTargetClick(Red)" active="false"
            fontSize="14" color="#2D1E1EE6" textColor="#FFBBBB"
            preferredHeight="34" text="—" />
    <Button id="rallyBtn_Yellow" onClick="onRallyTargetClick(Yellow)" active="false"
            fontSize="14" color="#2D2D19E6" textColor="#FFFFBB"
            preferredHeight="34" text="—" />
    <Button id="rallyBtn_Green" onClick="onRallyTargetClick(Green)" active="false"
            fontSize="14" color="#1E2D1EE6" textColor="#BBFFBB"
            preferredHeight="34" text="—" />
    <Button id="rallyBtn_Blue" onClick="onRallyTargetClick(Blue)" active="false"
            fontSize="14" color="#1E1E32E6" textColor="#BBCCFF"
            preferredHeight="34" text="—" />
    <Button id="rallyCancel" onClick="onRallyCancel"
            fontSize="14" color="#321E1EE6" textColor="#FFAAAA"
            preferredHeight="30" text="Cancel" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- H.5  REST CHOICE DIALOG — pick Hunger or Sanity for Rest action    -->
<!-- ================================================================== -->
<Panel id="restChoiceDialog"
       rectAlignment="MiddleCenter"
       width="360" height="160"
       color="#0A0A0AEB"
       outline="#64C86466"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="8" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text fontSize="18" fontStyle="Bold" color="#BBFFBB"
          text="Rest — choose recovery:" preferredHeight="28" />
    <HorizontalLayout spacing="20" childForceExpandWidth="true"
                      preferredHeight="50">
      <Button id="restHunger"
              onClick="onRestHunger"
              fontSize="16" color="#3C280AE6" textColor="#FFCC66"
              text="+1 Hunger" />
      <Button id="restSanity"
              onClick="onRestSanity"
              fontSize="16" color="#0A1E3CE6" textColor="#88CCFF"
              text="+2 Sanity" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- RESOURCE PICKER — "pick any resource" moments (Ellie's pantry).    -->
<!-- Delivers the chosen token(s) straight to the board; no bag rummage. -->
<!-- ================================================================== -->
<Panel id="resourcePickerDialog"
       rectAlignment="MiddleCenter"
       width="380" height="330"
       color="#0A0A0AEB"
       outline="#C8C86480"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text id="resourcePickTitle" fontSize="18" fontStyle="Bold" color="#FFDD88"
          text="Take which resource?" preferredHeight="26" />
    <Text id="resourcePickBody" fontSize="12" color="#AABBAA" preferredHeight="18"
          text="Choose a resource — tokens go straight to your board." />
    <HorizontalLayout spacing="6" childForceExpandWidth="true" preferredHeight="34">
      <Button id="resPickWood" onClick="onResourcePickClick(Wood)"
              fontSize="14" color="#3A2A18E6" textColor="#E0C090" text="Wood" />
      <Button id="resPickMetal" onClick="onResourcePickClick(Metal)"
              fontSize="14" color="#26262CE6" textColor="#C8C8D0" text="Metal" />
      <Button id="resPickCloth" onClick="onResourcePickClick(Cloth)"
              fontSize="14" color="#2C2C2CE6" textColor="#EEEEEE" text="Cloth" />
    </HorizontalLayout>
    <HorizontalLayout spacing="6" childForceExpandWidth="true" preferredHeight="34">
      <Button id="resPickFood" onClick="onResourcePickClick(Food)"
              fontSize="14" color="#3A1818E6" textColor="#FFAAAA" text="Food" />
      <Button id="resPickEnergy" onClick="onResourcePickClick(EnergyDrink)"
              fontSize="14" color="#3A3A18E6" textColor="#FFFF99" text="Energy Drink" />
      <Button id="resPickBattery" onClick="onResourcePickClick(Battery)"
              fontSize="14" color="#18243AE6" textColor="#AAC8FF" text="Battery" />
    </HorizontalLayout>
    <Button id="resPickCancel" onClick="onResourcePickCancel"
            fontSize="14" color="#321E1EE6" textColor="#FFAAAA"
            preferredHeight="30" text="Cancel (take a random draw)" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- COMBAT PANEL — Press the Attack (Design §12.5)                     -->
<!-- Shown while a press window is open; any fighter in the combat may  -->
<!-- press for 1 Sanity, or finish to let the enemy strike back.        -->
<!-- ================================================================== -->
<Panel id="combatPanel"
       rectAlignment="LowerCenter" offsetXY="0 230"
       width="540" height="92"
       color="#140505F0"
       outline="#C8505099"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="4" padding="8 8 6 6" childForceExpandHeight="false">
    <Text id="combatStatus" fontSize="15" fontStyle="Bold" color="#FFBBBB"
          text="Combat" preferredHeight="24" />
    <HorizontalLayout spacing="12" childForceExpandWidth="true" preferredHeight="46">
      <Button id="pressAttackBtn"
              onClick="onPressAttack"
              fontSize="15" color="#461414F2" textColor="#FFDDDD"
              text="Press the Attack (−1 Sanity)" />
      <Button id="finishCombatBtn"
              onClick="onFinishCombat"
              fontSize="15" color="#1E1E28E6" textColor="#CCCCDD"
              text="Finish (let it strike back)" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- DUSK SCRAMBLE PANEL — one 1-tile move per character, 1 Hunger      -->
<!-- Shown during Dusk; hidden when Night begins (Design §11.3)         -->
<!-- ================================================================== -->
<Panel id="duskPanel"
       rectAlignment="LowerCenter"
       offsetXY="0 10"
       width="1100" height="150"
       color="#0F0A19E0"
       outline="#C88CFF59"
       outlineSize="1"
       active="false">
  <VerticalLayout spacing="4" padding="6 10 6 10">
    <Text fontSize="14" fontStyle="Bold" color="#DDAAFF" preferredHeight="22"
          text="Dusk — scramble 1 tile (costs 1 Hunger, once per character), or stay put. You sleep where you stand." />
    <HorizontalLayout spacing="8" childForceExpandWidth="true"
                      preferredHeight="46">
      <Button id="duskJamesHouse"
              onClick="onDuskMoveClick(JamesHouse)"
              fontSize="13" color="#231E2DE6" textColor="#DDCCFF"
              tooltip="Scramble to James's House (must be adjacent)."
              text="James's House" />
      <Button id="duskEllieLucaHouse"
              onClick="onDuskMoveClick(EllieLucaHouse)"
              fontSize="13" color="#231E2DE6" textColor="#DDCCFF"
              tooltip="Scramble to Ellie &amp; Luca's House (must be adjacent)."
              text="Ellie &amp; Luca's" />
      <Button id="duskRaymanHouse"
              onClick="onDuskMoveClick(RaymanHouse)"
              fontSize="13" color="#231E2DE6" textColor="#DDCCFF"
              tooltip="Scramble to Rayman's House (must be adjacent)."
              text="Rayman's House" />
      <Button id="duskBasketballCourt"
              onClick="onDuskMoveClick(BasketballCourt)"
              fontSize="13" color="#2D1E1EE6" textColor="#FFCCAA"
              tooltip="Scramble to the Basketball Court. Risky at night — but survivors salvage 2 resources at Dawn."
              text="Basketball Court" />
      <Button id="duskBadmintonCourt"
              onClick="onDuskMoveClick(BadmintonCourt)"
              fontSize="13" color="#2D1E1EE6" textColor="#FFCCAA"
              tooltip="Scramble to the Badminton Court. Risky at night — but survivors salvage 2 resources at Dawn."
              text="Badminton Court" />
    </HorizontalLayout>
    <!-- Ready-check: Night begins automatically when everyone has clicked. -->
    <Button id="duskReadyBtn"
            onClick="onDuskReadyClick"
            fontSize="14" fontStyle="Bold"
            color="#192D23F2" textColor="#AAFFCC"
            preferredHeight="38"
            tooltip="Click when you're settled for the night. Night begins automatically once every seated player is ready. Click again to un-ready."
            text="I'm settled — Ready for Night" />
  </VerticalLayout>
</Panel>
