              onClick="onDuskMoveClick(BasketballCourt)"
              fontSize="13" color="#2D1E1EE6" textColor="#FFCCAA"
              tooltip="Scramble to the Basketball Court. Risky at night — but survivors salvage 2 resources at Dawn."
              text="Basketball Court" />
      <Button id="duskBadmintonCourt"
              onClick="onDuskMoveClick(BadmintonCourt)"
              fontSize="13" color="#2D1E1EE6" textColor="#FFCCAA"
              tooltip="Scramble to the Badminton Court. Risky at night — but survivors salvage 2 resources at Dawn."
              text="Badminton Court" />
    </HorizontalLayout>
    <!-- Ready-check: Night begins automatically when everyone has clicked. -->
    <Button id="duskReadyBtn"
            onClick="onDuskReadyClick"
            fontSize="14" fontStyle="Bold"
            color="#192D23F2" textColor="#AAFFCC"
            preferredHeight="38"
            tooltip="Click when you're settled for the night. Night begins automatically once every seated player is ready. Click again to un-ready."
            text="I'm settled — Ready for Night" />
  </VerticalLayout>
</Panel>
