<!-- global_ui.xml — All global XML UI panels for Starve No More -->
<!-- TTS XML UI reference: position is in screen-space pixels from center -->

<!-- ================================================================== -->
<!-- G.1  PHASE BANNER — persistent top-of-screen status bar            -->
<!-- Design §18.11: Day / Phase / Doom / Active player / Next action    -->
<!-- ================================================================== -->
<Panel id="phaseBanner"
       rectAlignment="UpperCenter"
       offsetXY="0 -5"
       width="1400" height="64"
       color="rgba(0,0,0,0.75)"
       outline="rgba(80,180,220,0.4)"
       outlineSize="1"
       active="true">
  <HorizontalLayout spacing="12" padding="8 14 8 14"
                    childForceExpandWidth="false"
                    childAlignment="MiddleCenter">
    <!-- Day -->
    <Text id="bannerDay"
          fontSize="20" fontStyle="Bold"
          color="#88DDFF"
          preferredWidth="130"
          text="Day 1 of 7" />
    <!-- Separator -->
    <Text fontSize="18" color="#445566" text="|" preferredWidth="10" />
    <!-- Phase -->
    <Text id="bannerPhase"
          fontSize="18"
          color="#AACCDD"
          preferredWidth="220"
          text="Dusk of the Week" />
    <!-- Separator -->
    <Text fontSize="18" color="#445566" text="|" preferredWidth="10" />
    <!-- Doom -->
    <Text id="bannerDoom"
          fontSize="20" fontStyle="Bold"
          color="#FFDD66"
          preferredWidth="200"
          text="Doom 0 / 30" />
    <!-- Separator -->
    <Text fontSize="18" color="#445566" text="|" preferredWidth="10" />
    <!-- Active Player -->
    <Text id="bannerActive"
          fontSize="18"
          color="#FFFFFF"
          preferredWidth="180"
          text="— pre-game —" />
    <!-- Separator -->
    <Text fontSize="18" color="#445566" text="|" preferredWidth="10" />
    <!-- Next Action -->
    <Text id="bannerNext"
          fontSize="17" fontStyle="Italic"
          color="#BBDDBB"
          preferredWidth="300"
          text="Click Setup to begin" />
    <!-- Help button -->
    <Button id="helpBtn"
            onClick="onHelpClick"
            fontSize="22" fontStyle="Bold"
            color="rgba(40,80,100,0.9)"
            textColor="#88EEFF"
            preferredWidth="44" preferredHeight="44"
            text="?" />
    <!-- What now? button -->
    <Button id="hintBtn"
            onClick="onWhatNowClick"
            fontSize="14"
            color="rgba(40,80,60,0.9)"
            textColor="#BBFFBB"
            preferredWidth="100" preferredHeight="44"
            text="What now?" />
  </HorizontalLayout>
</Panel>

<!-- ================================================================== -->
<!-- G.10  HOST CONTROL PANEL — phase advance buttons (host-only)       -->
<!-- ================================================================== -->
<Panel id="hostControls"
       rectAlignment="UpperLeft"
       offsetXY="10 -80"
       width="200" height="310"
       color="rgba(0,0,0,0.7)"
       outline="rgba(255,200,100,0.3)"
       outlineSize="1"
       active="true">
  <VerticalLayout spacing="6" padding="8 8 8 8"
                  childForceExpandHeight="false">
    <Text fontSize="14" fontStyle="Bold" color="#FFD080"
          text="Host Controls" preferredHeight="22" />
    <Button id="btnSetup"
            onClick="onHostSetupGuided"
            fontSize="15" color="rgba(30,40,30,0.9)" textColor="#BBFFBB"
            preferredHeight="38"
            text="Setup Game" />
    <Button id="btnBeginDay"
            onClick="onHostBeginDay"
            fontSize="15" color="rgba(20,40,60,0.9)" textColor="#88DDFF"
            preferredHeight="38"
            text="Begin Day" />
    <Button id="btnResolveNight"
            onClick="onHostResolveNight"
            fontSize="15" color="rgba(20,30,50,0.9)" textColor="#AABBDD"
            preferredHeight="38"
            text="Resolve Night" />
    <Button id="btnEndTurn"
            onClick="onHostEndTurn"
            fontSize="15" color="rgba(40,40,30,0.9)" textColor="#DDDDAA"
            preferredHeight="38"
            text="End Turn / Pass" />
    <Button id="btnRestart"
            onClick="onHostRestart"
            fontSize="15" color="rgba(50,20,20,0.9)" textColor="#FFAAAA"
            preferredHeight="38"
            text="Restart" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- G.3  ACTION BAR — per-player action buttons (bottom of screen)     -->
<!-- Design §18.13: 7 action buttons + 3 cubes                         -->
<!-- Visibility set dynamically by Lua to the active player only        -->
<!-- ================================================================== -->
<Panel id="actionBar"
       rectAlignment="LowerCenter"
       offsetXY="0 10"
       width="1100" height="110"
       color="rgba(0,0,0,0.75)"
       outline="rgba(100,180,100,0.3)"
       outlineSize="1"
       active="false">
  <VerticalLayout spacing="4" padding="6 10 6 10">
    <!-- Action Buttons Row -->
    <HorizontalLayout spacing="8" childForceExpandWidth="true"
                      preferredHeight="52">
      <Button id="actMove"
              onClick="onActMove"
              fontSize="14" color="rgba(30,50,40,0.9)" textColor="#CCFFCC"
              tooltip="Move to an adjacent location. Costs 1 action + 1 Hunger."
              text="Move (1)" />
      <Button id="actGather"
              onClick="onActGather"
              fontSize="14" color="rgba(30,50,40,0.9)" textColor="#CCFFCC"
              tooltip="Gather 1 resource from this location's bag. Costs 1 action."
              text="Gather (1)" />
      <Button id="actCraft"
              onClick="onActCraft"
              fontSize="14" color="rgba(30,50,40,0.9)" textColor="#CCFFCC"
              tooltip="Craft an item from the Market. Costs 1 action + resources."
              text="Craft (1)" />
      <Button id="actCook"
              onClick="onActCook"
              fontSize="14" color="rgba(30,50,40,0.9)" textColor="#CCFFCC"
              tooltip="Cook a recipe at a Crockpot location. Costs 1 action + ingredients."
              text="Cook (1)" />
      <Button id="actFight"
              onClick="onActFight"
              fontSize="14" color="rgba(30,50,40,0.9)" textColor="#CCFFCC"
              tooltip="Fight a threat at this location. Costs 1 action."
              text="Fight (1)" />
      <Button id="actRest"
              onClick="onActRest"
              fontSize="14" color="rgba(30,50,40,0.9)" textColor="#CCFFCC"
              tooltip="Rest: +1 Hunger or +2 Sanity. At your own house: also +1 Health."
              text="Rest (1)" />
      <Button id="actCleanse"
              onClick="onActCleanse"
              fontSize="14" color="rgba(30,50,40,0.9)" textColor="#CCFFCC"
              tooltip="Cleanse the Doom track (-2). Costs 1 Wood + 1 Cloth + 1 Battery + 1 Energy Drink."
              text="Cleanse (1)" />
      <Button id="actPass"
              onClick="onActPass"
              fontSize="14" color="rgba(50,40,30,0.9)" textColor="#FFDDAA"
              tooltip="End your turn. Remaining actions are forfeited."
              text="Pass" />
    </HorizontalLayout>
    <!-- Action Cubes Row -->
    <HorizontalLayout spacing="6" childForceExpandWidth="false"
                      childAlignment="MiddleCenter"
                      preferredHeight="30">
      <Text fontSize="13" color="#889988" text="Actions:" preferredWidth="65" />
      <Text id="cube1" fontSize="20" color="#66FF66" text="■" preferredWidth="28" />
      <Text id="cube2" fontSize="20" color="#66FF66" text="■" preferredWidth="28" />
      <Text id="cube3" fontSize="20" color="#66FF66" text="■" preferredWidth="28" />
      <Text id="cubeLabel" fontSize="13" color="#889988" text="3 remaining"
            preferredWidth="100" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- G.5  STAT DISPLAY — shows active player's stats (left side)        -->
<!-- Updated dynamically by Lua                                         -->
<!-- ================================================================== -->
<Panel id="statDisplay"
       rectAlignment="MiddleLeft"
       offsetXY="10 0"
       width="180" height="220"
       color="rgba(0,0,0,0.7)"
       outline="rgba(150,150,150,0.3)"
       outlineSize="1"
       active="false">
  <VerticalLayout spacing="4" padding="8 8 8 8"
                  childForceExpandHeight="false">
    <Text id="statCharName" fontSize="16" fontStyle="Bold" color="#FFFFFF"
          text="—" preferredHeight="22" />

    <!-- Health -->
    <HorizontalLayout spacing="4" preferredHeight="28">
      <Text fontSize="14" color="#FF6666" text="HP" preferredWidth="28" />
      <ProgressBar id="statHealthBar" percentage="100"
                   color="#FF4444" backgroundColor="rgba(80,20,20,0.6)"
                   preferredWidth="100" />
      <Text id="statHealthVal" fontSize="14" color="#FF8888" text="8/8"
            preferredWidth="40" />
    </HorizontalLayout>

    <!-- Hunger -->
    <HorizontalLayout spacing="4" preferredHeight="28">
      <Text fontSize="14" color="#FFAA44" text="HU" preferredWidth="28" />
      <ProgressBar id="statHungerBar" percentage="100"
                   color="#FFAA22" backgroundColor="rgba(80,50,10,0.6)"
                   preferredWidth="100" />
      <Text id="statHungerVal" fontSize="14" color="#FFCC66" text="6/6"
            preferredWidth="40" />
    </HorizontalLayout>

    <!-- Sanity -->
    <HorizontalLayout spacing="4" preferredHeight="28">
      <Text fontSize="14" color="#66BBFF" text="SA" preferredWidth="28" />
      <ProgressBar id="statSanityBar" percentage="100"
                   color="#4488FF" backgroundColor="rgba(20,30,80,0.6)"
                   preferredWidth="100" />
      <Text id="statSanityVal" fontSize="14" color="#88CCFF" text="10/10"
            preferredWidth="40" />
    </HorizontalLayout>

    <!-- Location -->
    <Text id="statLocation" fontSize="12" color="#AAAAAA"
          text="Location: —" preferredHeight="20" />

    <!-- Stat adjust buttons (manual +/- for edge cases) -->
    <HorizontalLayout spacing="2" preferredHeight="24">
      <Button id="statHealthMinus" onClick="onStatHealthMinus"
              fontSize="12" color="rgba(80,20,20,0.8)" textColor="#FF8888"
              preferredWidth="28" text="-H" />
      <Button id="statHealthPlus" onClick="onStatHealthPlus"
              fontSize="12" color="rgba(20,60,20,0.8)" textColor="#88FF88"
              preferredWidth="28" text="+H" />
      <Button id="statHungerMinus" onClick="onStatHungerMinus"
              fontSize="12" color="rgba(80,40,10,0.8)" textColor="#FFCC66"
              preferredWidth="28" text="-U" />
      <Button id="statHungerPlus" onClick="onStatHungerPlus"
              fontSize="12" color="rgba(20,60,20,0.8)" textColor="#88FF88"
              preferredWidth="28" text="+U" />
      <Button id="statSanityMinus" onClick="onStatSanityMinus"
              fontSize="12" color="rgba(20,20,80,0.8)" textColor="#88CCFF"
              preferredWidth="28" text="-S" />
      <Button id="statSanityPlus" onClick="onStatSanityPlus"
              fontSize="12" color="rgba(20,60,20,0.8)" textColor="#88FF88"
              preferredWidth="28" text="+S" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- G.6  CONFIRM DIALOG — modal for resource-spending actions          -->
<!-- Design §18.14: costs visible before commitment                     -->
<!-- ================================================================== -->
<Panel id="confirmDialog"
       rectAlignment="MiddleCenter"
       width="440" height="200"
       color="rgba(10,10,10,0.92)"
       outline="rgba(200,200,100,0.5)"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="8" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text id="confirmTitle" fontSize="20" fontStyle="Bold" color="#FFDD88"
          text="Confirm Action" preferredHeight="28" />
    <Text id="confirmBody" fontSize="15" color="#CCCCCC"
          text="Cost: ???\nYou have: ???"
          preferredHeight="60" />
    <HorizontalLayout spacing="20" childForceExpandWidth="true"
                      preferredHeight="44">
      <Button id="confirmYes"
              onClick="onConfirmYes"
              fontSize="18" fontStyle="Bold"
              color="rgba(30,80,30,0.9)" textColor="#88FF88"
              text="Confirm" />
      <Button id="confirmNo"
              onClick="onConfirmNo"
              fontSize="18"
              color="rgba(80,30,30,0.9)" textColor="#FF8888"
              text="Cancel" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- I.4  END-OF-ROUND SUMMARY — auto-dismiss panel after Tick          -->
<!-- Stubbed here, populated by Lua in Phase I                          -->
<!-- ================================================================== -->
<Panel id="summaryPanel"
       rectAlignment="MiddleCenter"
       width="600" height="340"
       color="rgba(5,10,15,0.92)"
       outline="rgba(80,180,220,0.4)"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text id="summaryTitle" fontSize="22" fontStyle="Bold" color="#88DDFF"
          text="End of Day" preferredHeight="28" />
    <Text id="summaryBody" fontSize="14" color="#BBCCDD"
          text=""
          preferredHeight="220" />
    <Button id="summaryClose"
            onClick="onSummaryClose"
            fontSize="16" color="rgba(40,40,40,0.9)" textColor="#AAAAAA"
            preferredHeight="36"
            text="Continue" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- H.1  SETUP WALKTHROUGH — 4-step guided modal                       -->
<!-- Step 1: Path graph pick                                            -->
<!-- ================================================================== -->
<Panel id="setupStep1"
       rectAlignment="MiddleCenter"
       width="560" height="340"
       color="rgba(5,10,15,0.94)"
       outline="rgba(200,180,100,0.5)"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="8" padding="16 16 16 16"
                  childForceExpandHeight="false">
    <Text fontSize="20" fontStyle="Bold" color="#FFD080"
          text="Step 1 — Choose the Map Layout" preferredHeight="28" />
    <Text fontSize="14" color="#CCCCAA"
          text="Pick the path layout that connects locations. This affects how far apart tiles are."
          preferredHeight="36" />
    <HorizontalLayout spacing="14" childForceExpandWidth="true"
                      preferredHeight="70">
      <Button id="pickCompact"
              onClick="onPickPath"
              fontSize="15" color="rgba(30,40,30,0.9)" textColor="#CCFFCC"
              text="Compact\n(close together)" />
      <Button id="pickSprawl"
              onClick="onPickPath"
              fontSize="15" color="rgba(30,40,30,0.9)" textColor="#CCFFCC"
              text="Sprawl\n(spread out)" />
      <Button id="pickLinear"
              onClick="onPickPath"
              fontSize="15" color="rgba(30,40,30,0.9)" textColor="#CCFFCC"
              text="Linear\n(line path)" />
    </HorizontalLayout>
    <HorizontalLayout spacing="14" childForceExpandWidth="true"
                      preferredHeight="70">
      <Button id="pickRing"
              onClick="onPickPath"
              fontSize="15" color="rgba(30,40,30,0.9)" textColor="#CCFFCC"
              text="Ring\n(circular loop)" />
      <Button id="pickStar"
              onClick="onPickPath"
              fontSize="15" color="rgba(30,40,30,0.9)" textColor="#CCFFCC"
              text="Star\n(central hub)" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- H.1  SETUP WALKTHROUGH — Step 2: Character pick                    -->
<!-- ================================================================== -->
<Panel id="setupStep2"
       rectAlignment="MiddleCenter"
       width="660" height="380"
       color="rgba(5,10,15,0.94)"
       outline="rgba(200,180,100,0.5)"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text id="step2Title" fontSize="20" fontStyle="Bold" color="#FFD080"
          text="Step 2 — Pick Your Character" preferredHeight="28" />
    <Text id="step2Subtitle" fontSize="14" color="#CCCCAA"
          text="Choose a character. Each has unique strengths and a constraint."
          preferredHeight="24" />
    <HorizontalLayout spacing="8" childForceExpandWidth="true"
                      preferredHeight="260">
      <Button id="pickJames"
              onClick="onPickChar"
              fontSize="13" color="rgba(40,40,50,0.9)" textColor="#FFFFFF"
              text="JAMES\nThe Gamer\nHP 8 HU 6 SA 10\n\nPeek decks\nReroll dice\n\nNeeds Energy Drinks" />
      <Button id="pickCoco"
              onClick="onPickChar"
              fontSize="13" color="rgba(50,30,30,0.9)" textColor="#FFCCCC"
              text="COCO\nThe Angel\nHP 6 HU 8 SA 12\n\nCalming Presence\nCharlie immune\n\nNo Home" />
      <Button id="pickRayman"
              onClick="onPickChar"
              fontSize="13" color="rgba(50,50,30,0.9)" textColor="#FFFFCC"
              text="RAYMAN\nThe Athlete\nHP 12 HU 10 SA 6\n\nSpeed + Court Master\nDefend allies\n\nBig Appetite + Loud" />
      <Button id="pickEllie"
              onClick="onPickChar"
              fontSize="13" color="rgba(30,50,30,0.9)" textColor="#CCFFCC"
              text="ELLIE\nThe Cook\nHP 8 HU 10 SA 8\n\nCrockpot Master\nComfort Food\n\nCan't eat raw food" />
      <Button id="pickLuca"
              onClick="onPickChar"
              fontSize="13" color="rgba(30,30,50,0.9)" textColor="#CCCCFF"
              text="LUCA\nThe Orator\nHP 7 HU 8 SA 10\n\nRally + Calm Words\nStoryteller\n\nNeeds an Audience" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- H.2  CHARACTER BRIEFING — one-time popup after pick                -->
<!-- ================================================================== -->
<Panel id="charBriefing"
       rectAlignment="MiddleCenter"
       width="540" height="440"
       color="rgba(5,10,15,0.94)"
       outline="rgba(100,200,220,0.5)"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text id="briefTitle" fontSize="22" fontStyle="Bold" color="#88DDFF"
          text="Your Character" preferredHeight="28" />
    <Text id="briefBody" fontSize="13" color="#CCDDEE"
          text=""
          preferredHeight="340" />
    <Button id="briefDismiss"
            onClick="onBriefDismiss"
            fontSize="16" color="rgba(30,60,60,0.9)" textColor="#88FFFF"
            preferredHeight="38"
            text="I understand — let's go!" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- H.3  HELP PANEL — side panel with 5 tabs (Design §18.17)          -->
<!-- ================================================================== -->
<Panel id="helpPanel"
       rectAlignment="MiddleRight"
       offsetXY="-10 0"
       width="400" height="650"
       color="rgba(5,10,20,0.94)"
       outline="rgba(80,180,220,0.3)"
       outlineSize="1"
       active="false">
  <VerticalLayout spacing="4" padding="10 10 10 10"
                  childForceExpandHeight="false">
    <!-- Tab bar -->
    <HorizontalLayout spacing="4" preferredHeight="32">
      <Button id="helpTabQuick"
              onClick="onHelpTab"
              fontSize="12" color="rgba(20,50,60,0.9)" textColor="#88DDFF"
              text="Quick Start" />
      <Button id="helpTabChar"
              onClick="onHelpTab"
              fontSize="12" color="rgba(20,40,40,0.8)" textColor="#AACCCC"
              text="Character" />
      <Button id="helpTabDawn"
              onClick="onHelpTab"
              fontSize="12" color="rgba(20,40,40,0.8)" textColor="#AACCCC"
              text="Dawn" />
      <Button id="helpTabDoom"
              onClick="onHelpTab"
              fontSize="12" color="rgba(20,40,40,0.8)" textColor="#AACCCC"
              text="Doom" />
      <Button id="helpTabGlossary"
              onClick="onHelpTab"
              fontSize="12" color="rgba(20,40,40,0.8)" textColor="#AACCCC"
              text="Glossary" />
    </HorizontalLayout>
    <!-- Tab title -->
    <Text id="helpTabTitle" fontSize="16" fontStyle="Bold" color="#88DDFF"
          text="Quick Start" preferredHeight="22" />
    <!-- Tab content -->
    <Text id="helpBody" fontSize="12" color="#BBCCDD"
          text=""
          preferredHeight="530" />
    <!-- Close -->
    <Button id="helpClose"
            onClick="onHelpClose"
            fontSize="14" color="rgba(40,40,40,0.9)" textColor="#AAAAAA"
            preferredHeight="30"
            text="Close" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- H.5  REST CHOICE DIALOG — pick Hunger or Sanity for Rest action    -->
<!-- ================================================================== -->
<Panel id="restChoiceDialog"
       rectAlignment="MiddleCenter"
       width="360" height="160"
       color="rgba(10,10,10,0.92)"
       outline="rgba(100,200,100,0.4)"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="8" padding="14 14 14 14"
                  childForceExpandHeight="false">
    <Text fontSize="18" fontStyle="Bold" color="#BBFFBB"
          text="Rest — choose recovery:" preferredHeight="28" />
    <HorizontalLayout spacing="20" childForceExpandWidth="true"
                      preferredHeight="50">
      <Button id="restHunger"
              onClick="onRestHunger"
              fontSize="16" color="rgba(60,40,10,0.9)" textColor="#FFCC66"
              text="+1 Hunger" />
      <Button id="restSanity"
              onClick="onRestSanity"
              fontSize="16" color="rgba(10,30,60,0.9)" textColor="#88CCFF"
              text="+2 Sanity" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>
