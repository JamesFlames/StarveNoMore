        <HorizontalLayout spacing="2" preferredHeight="12">
          <Text fontSize="9" color="#FF6666" text="H" preferredWidth="10"
                tooltip="Health — at 0 this character goes Down (ghost) until revived with a Telltale Heart."
                tooltipPosition="Left" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF" />
          <ProgressBar id="rosterHealth_Ellie" percentage="100"
