<!-- ACTION TOOLTIP — custom help strip for the action buttons. Sits    -->
<!-- just ABOVE the action bar, fully opaque, and appears only after    -->
<!-- a hover delay (onActionTooltipEnter/Exit in ui_actionbar.lua).     -->
<!-- ================================================================== -->
