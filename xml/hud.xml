<!-- hud.xml — persistent HUD: Phase Banner, day-cycle strip, Dawn checklist,
     Host Controls, Rules-in-effect panel, Action Bar, stat display, roster. -->
<!-- TTS XML UI reference: position is in screen-space pixels from center. -->

<!-- ================================================================== -->
<!-- G.1  PHASE BANNER — persistent top-of-screen status bar            -->
<!-- Design §18.11: Day / Phase / Doom / Active player / Next action    -->
<!-- ================================================================== -->
<!-- The bar used to be flush with y=0, and that put it directly on top of the
     one piece of TTS chrome we cannot move: its turn plate, which Hotseat
     draws at the top-CENTRE of the screen (measured y=30..57, ~120px wide) and
     re-enables itself however often the script switches it off. Our panel is
     drawn over it, so the plate's End Turn button — tooltip "Click to End
     turn", the thing a hotseat driver uses to hand the seat on — was both
     invisible and unclickable behind an opaque bar.
     So the top strip belongs to TTS now: offsetXY sets the CENTRE, and
     offsetY = -(TTS_TURN_PLATE_CLEARANCE + height/2) starts the bar at y=72,
     15px clear of the plate. Everything else anchored to the top of the screen
     moved down with it. Guards:
     test_xml_quality.py::test_phase_banner_clears_the_tts_turn_plate and
     ::test_nothing_covers_the_tts_turn_plate. -->
<Panel id="phaseBanner"
       rectAlignment="UpperCenter"
       offsetXY="0 -104"
       width="1470" height="64"
       color="#000000BF"
       outline="#50B4DC66"
       outlineSize="1"
       active="true">
  <!-- Slot widths must hold the LONGEST runtime string each field can carry,
       not the placeholder below: a TTS Text overflows its preferredWidth and
       draws straight over its neighbours instead of wrapping or clipping, so
       an undersized slot garbles the whole bar. "Doom 30 / 30  (next: 25)"
       needs ~250 and had 200; "Rayman's turn (Yellow)" needs ~215 and had
       180 — which is why whose-turn-it-is was unreadable. The separator bars
       were dropped to pay for the extra width; spacing does that job.
       Guard: test_xml_quality.py::test_phase_banner_slots_fit_their_text. -->
  <!-- spacing is 14, not 16: the row must stay inside 1470px
       (test_phase_banner_row_fits_inside_its_panel), and bannerOmen's 28px
       slot was paid for out of the spacing rather than out of a text slot. -->
  <HorizontalLayout spacing="14" padding="8 14 8 14"
                    childForceExpandWidth="false"
                    childAlignment="MiddleCenter">
    <!-- Day. 118, not 130: "Day 7 of 7" is the longest string this field can
         ever hold (the only other length is Long Weekend's "Day 3 of 3"), so
         the 12px it was carrying spare went to bannerActive, which now also
         has to fit "Rayman settles (Yellow)" at Dusk. -->
    <Text id="bannerDay"
          fontSize="20" fontStyle="Bold"
          color="#88DDFF"
          preferredWidth="118"
          text="Day 1 of 7" />
    <!-- Phase -->
    <Text id="bannerPhase"
          fontSize="18"
          color="#AACCDD"
          preferredWidth="170"
          text="Dusk of the Week" />
    <!-- Active Player — placed BEFORE Doom, and that order is load-bearing.
         TTS draws its own turn plate at the top-centre of the screen, which is
         also the centre of this bar, and in Hotseat it re-enables itself
         however often the script switches it off (there is no API to hide
         built-in chrome — checked the Player instance and the base function
         list). Whichever field sits at the centre therefore gets a faded
         player name showing through from behind it. While that field was this
         one, the bar appeared to answer "whose turn is it" twice, differently:
         our "James's turn (Blue)" over a ghosted "Raymanx". Doom takes the
         centre now — a yellow "Doom 12 / 30" with a name behind it is noise,
         not a contradiction.
         The bar has since moved down clear of the plate (see the panel comment
         above), so nothing ghosts through it at the measured size. The order
         stays: the plate is TTS chrome and grows with the player's interface
         scale, and if it ever reaches down this far, Doom is still the field
         that can afford to share the space.
         Widening this field to name the player as well was tried first and
         does not fit: the row is 1462px of the 1470px panel once the three
         buttons are counted, and an overflowing Text draws over its neighbour.
         Guard: test_phase_banner_active_field_is_not_centred. -->
    <Text id="bannerActive"
          fontSize="18"
          color="#FFFFFF"
          preferredWidth="232"
          text="— pre-game —" />
    <!-- Doom -->
    <Text id="bannerDoom"
          fontSize="20" fontStyle="Bold"
          color="#FFDD66"
          preferredWidth="270"
          text="Doom 0 / 30" />
    <!-- Next Action -->
    <Text id="bannerNext"
          fontSize="17" fontStyle="Italic"
          color="#BBDDBB"
          preferredWidth="300"
          text="Click Setup to begin" />
    <!-- NIGHT OMEN — the visual twin of the Dusk growl (Design §15.8, §18.19
         item 2). Blank all week; a waning moon appears at Dusk on exactly the
         nights the growl plays, and clears at the next Dawn. It carries the
         same single bit the sound does and no more: something hard is next,
         not what or where. Deliberately not the severity-dot glyph (●) — that
         vocabulary means "read this card", and this is not a card.
         Set by setNightOmen() in ui_banner.lua. -->
    <Text id="bannerOmen"
          fontSize="20"
          color="#8899BB"
          preferredWidth="28"
          tooltip="A waning moon. It shows up on the nights the neighborhood&#10;makes that sound — the same warning, for anyone playing muted.&#10;What it means is for you to find out."
          tooltipPosition="Below" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF"
          text="" />
    <!-- Help button. Reads "Rules", not "?" — a lone question mark is a
         convention, and a table that has never played this mod has to click it
         to find out it holds the whole rulebook. The word says so.
         The extra 12px comes out of the row's slack;
         test_phase_banner_row_fits_inside_its_panel is the guard. -->
    <Button id="helpBtn"
            onClick="onHelpClick"
            fontSize="14" fontStyle="Bold"
            color="#285064E6"
            textColor="#88EEFF"
            preferredWidth="56" preferredHeight="44"
            tooltip="The help menu — Quick Start, the complete Rulebook, the&#10;glossary and the character briefings."
            tooltipPosition="Below" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF"
            text="Rules" />
    <!-- What next? button -->
    <Button id="hintBtn"
            onClick="onWhatNowClick"
            fontSize="14"
            color="#28503CE6"
            textColor="#BBFFBB"
            preferredWidth="100" preferredHeight="44"
            text="What next?" />
    <!-- Message Log toggle -->
    <Button id="logBtn"
            onClick="onMsgLogToggle"
            fontSize="14"
            color="#28323CE6"
            textColor="#BBDDFF"
            preferredWidth="60" preferredHeight="44"
            tooltip="Show or hide the Message Log — every game message stays there&#10;until you clear it."
            tooltipPosition="Below" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF"
            text="Log" />
  </HorizontalLayout>
</Panel>

<!-- ================================================================== -->
<!-- UI TOGGLE — always visible; hides/shows every custom panel so the  -->
<!-- default TTS controls underneath stay reachable (onToggleCustomUI). -->
<!-- ================================================================== -->
<Button id="uiToggle"
        rectAlignment="UpperRight"
        offsetXY="-10 -84"
        width="88" height="26"
        onClick="onToggleCustomUI"
        fontSize="12"
        color="#282828E6" textColor="#CCCCCC"
        tooltip="Hide or show all of this game's panels, so the standard&#10;Tabletop Simulator controls underneath are easy to reach."
        tooltipPosition="Left" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF"
        text="Hide UI" />

<!-- ================================================================== -->
<!-- DAY-CYCLE STRIP — Dawn ▸ Day ▸ Dusk ▸ Night ▸ Tick, current lit    -->
<!-- Updated by refreshCycleStrip() in ui_rules.lua                     -->
<!-- ================================================================== -->
<!-- -180, not -108: it keeps its 32px of air under the phase banner, which
     moved down 72px to clear TTS's turn plate. -->
<Panel id="cycleStrip"
       rectAlignment="UpperCenter"
       offsetXY="0 -180"
       width="640" height="24"
       color="#00000099"
       active="false"
       tooltip="The day cycle. Dawn: the world acts first. Day: your 3&#10;actions. Dusk: last scramble. Night: threats + sleep. Tick:&#10;stat decay. The lit step is where you are now.">
  <Text id="cycleText"
        fontSize="13"
        alignment="MiddleCenter"
        text="" />
</Panel>

<!-- ================================================================== -->
<!-- DAWN CHECKLIST — manual steps of the current Dawn card, tickable   -->
<!-- by any player. Populated by refreshDawnChecklist (ui_rules.lua);   -->
<!-- hides itself when every step is done.                              -->
<!-- ================================================================== -->
<Panel id="dawnChecklist"
       rectAlignment="UpperRight"
       offsetXY="-10 -136"
       width="400" height="208"
       color="#140C04E0"
       outline="#F0C87873"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="4" padding="10 10 8 8"
                  childForceExpandHeight="false">
    <Text fontSize="14" fontStyle="Bold" color="#FFD080"
          text="Dawn card — do these now (click to tick off):"
          preferredHeight="20" />
    <Button id="dawnStep_1" onClick="onDawnStepClick(1)" active="false"
            fontSize="12" color="#281C0CE6" textColor="#EEDDBB"
            alignment="MiddleLeft" preferredHeight="38" text="" />
    <Button id="dawnStep_2" onClick="onDawnStepClick(2)" active="false"
            fontSize="12" color="#281C0CE6" textColor="#EEDDBB"
            alignment="MiddleLeft" preferredHeight="38" text="" />
    <Button id="dawnStep_3" onClick="onDawnStepClick(3)" active="false"
            fontSize="12" color="#281C0CE6" textColor="#EEDDBB"
            alignment="MiddleLeft" preferredHeight="38" text="" />
    <Button id="dawnStep_4" onClick="onDawnStepClick(4)" active="false"
            fontSize="12" color="#281C0CE6" textColor="#EEDDBB"
            alignment="MiddleLeft" preferredHeight="38" text="" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- G.10  HOST CONTROL PANEL — phase advance buttons (host-only)       -->
<!-- Draggable: starts right of the TTS chat/menu corner, under the     -->
<!-- Phase Banner; players can drag it anywhere it isn't in the way.    -->
<!-- ================================================================== -->
<!-- offsetXY positions the panel's CENTRE, so its top edge is
     offsetY + height/2 above that point. At "360 -150" with height 310 the
     top landed at y=+5 — off the top of the screen and behind the Phase
     Banner (which spans 10..74 down), hiding the title row and the first
     buttons: "the end turn button is hidden underneath the Day 1 of 7 phase
     bar". Height is now its real content height (22 title + 5x38 buttons +
     5x6 spacing + 16 padding = 258) and the centre is far enough down that
     the top clears the banner. Guard:
     test_xml_quality.py::test_top_anchored_panels_clear_the_phase_banner.
     -302, not -230: the banner moved down 72px to clear TTS's turn plate, and
     this keeps the same 34px of air under it. -->
<Panel id="hostControls"
       rectAlignment="UpperLeft"
       offsetXY="360 -302"
       width="200" height="264"
       color="#000000B2"
       outline="#FFC8644C"
       outlineSize="1"
       allowDragging="true"
       returnToOriginalPositionWhenReleased="false"
       active="true">
  <VerticalLayout spacing="6" padding="8 8 8 8"
                  childForceExpandHeight="false">
    <Text fontSize="14" fontStyle="Bold" color="#FFD080"
          text="Host Controls" preferredHeight="22" />
    <Button id="btnSetup"
            onClick="onHostSetupGuided"
            fontSize="15" color="#2F7D34FF" textColor="#EAFFEA"
            preferredHeight="38"
            text="Setup Game" />
    <Button id="btnBeginDay"
            onClick="onHostBeginDay"
            fontSize="15" color="#1E6DB0FF" textColor="#EAF6FF"
            preferredHeight="38"
            text="Begin Day" />
    <Button id="btnResolveNight"
            onClick="onHostResolveNight"
            fontSize="15" color="#3B4694FF" textColor="#EAEEFF"
            preferredHeight="38"
            text="Resolve Night" />
    <Button id="btnEndTurn"
            onClick="onHostEndTurn"
            fontSize="15" color="#9A7A1EFF" textColor="#FFF7E0"
            preferredHeight="38"
            text="End Turn" />
    <Button id="btnRestart"
            onClick="onHostRestart"
            fontSize="15" color="#A23A3AFF" textColor="#FFEAEA"
            preferredHeight="38"
            text="Restart" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- RULES IN EFFECT — persistent list of every rule currently          -->
<!-- modifying play: sub-phase rules, Doom thresholds, ongoing Dawn     -->
<!-- effects, bosses, character statuses. ui_rules.lua refreshes it on  -->
<!-- every state change and sizes the panel to its content.             -->
<!-- ================================================================== -->
<!-- Anchored on the left BELOW the character box (statDisplay, MiddleLeft)
     rather than LowerLeft, where it sat on top of the TTS game-log/chat. -->
<Panel id="rulesPanel"
       rectAlignment="MiddleLeft"
       offsetXY="10 -240"
       width="230" height="120"
       color="#000000B2"
       outline="#78C8A059"
       outlineSize="1"
       active="false">
  <VerticalLayout spacing="4" padding="8 8 6 6"
                  childForceExpandHeight="false">
    <HorizontalLayout spacing="4" preferredHeight="22">
      <Text fontSize="13" fontStyle="Bold" color="#A8E6C8"
            text="Rules in effect" />
      <Button id="rulesToggle"
              onClick="onRulesToggle"
              fontSize="12" color="#1E3228E6" textColor="#A8E6C8"
              preferredWidth="24" preferredHeight="18"
              tooltip="Collapse / expand this panel."
              text="–" />
    </HorizontalLayout>
    <Text id="rulesBody" fontSize="11" color="#CCDDCC"
          alignment="UpperLeft"
          text="" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- G.3  ACTION BAR — per-player action buttons (bottom of screen)     -->
<!-- Design §18.13: 7 action buttons + 3 cubes                         -->
<!-- Visibility set dynamically by Lua to the active player only        -->
<!-- ================================================================== -->
<Panel id="actionBar"
       rectAlignment="LowerCenter"
       offsetXY="0 10"
       width="1100" height="110"
       color="#0B0E0CF7"
       outline="#64B4644C"
       outlineSize="1"
       active="false">
  <!-- Button help lives in ACTION_TOOLTIPS (ui_actionbar.lua), shown in the
       actionTooltip panel above the bar after a hover delay — not in native
       tooltip attributes (those render instantly, transparent, on the bar). -->
  <VerticalLayout spacing="4" padding="6 10 6 10">
    <!-- Action Buttons Row — TWO GROUPS, and the split is the point.
         Every button used to sit in one undifferentiated run, so the only way
         to learn that Pry and Rally are free while Rest and Cleanse are not
         was to spend an action finding out. The "(1)" suffix carried that
         information and was easy to read as part of the name.

         Membership is decided by whether the verb calls spendAction():
         costed = Move, Gather, Market Craft, Cook, Fight, Rest, Cleanse,
         Stabilize, Defend, Barricade, Appease, Clear. Everything else takes
         no action (Flee costs Sanity, Revive costs Health + a Heart, the
         Signature is once-per-game). Trade sits in FREE because its headline
         case is free — once per turn at your own tile; the trade dialog
         prices each partner individually.
         Guard: test_xml_quality.py::test_action_bar_groups_match_the_action_costs -->
    <HorizontalLayout spacing="6" childForceExpandWidth="false"
                      preferredHeight="52">
      <Text id="actGroupCostLabel" fontSize="10" fontStyle="Bold"
            color="#C8B48A" alignment="MiddleCenter"
            preferredWidth="34" flexibleWidth="0"
            text="COSTS&#10;1" />
      <HorizontalLayout id="actGroupCosted" spacing="8"
                        childForceExpandWidth="true" flexibleWidth="6">
      <Button id="actMove"
              onClick="onActMove"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#B9C9B4FF" textColor="#12180F"
              text="Move (1)" />
      <Button id="actGather"
              onClick="onActGather"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#B9C9B4FF" textColor="#12180F"
              text="Gather (1)" />
      <!-- "Craft" alone read as a generic verb and gave no hint that the
           thing it acts on is the Market row down the side of the table.
           Two lines because "Market Craft (1)" does not fit one at 14pt. -->
      <Button id="actCraft"
              onClick="onActCraft"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="12" color="#B9C9B4FF" textColor="#12180F"
              text="Market&#10;Craft (1)" />
      <Button id="actCook"
              onClick="onActCook"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#B9C9B4FF" textColor="#12180F"
              text="Cook (1)" />
      <Button id="actFight"
              onClick="onActFight"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#B9C9B4FF" textColor="#12180F"
              text="Fight (1)" />
      <Button id="actRest"
              onClick="onActRest"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#B9C9B4FF" textColor="#12180F"
              text="Rest (1)" />
      <Button id="actCleanse"
              onClick="onActCleanse"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#B9C9B4FF" textColor="#12180F"
              text="Cleanse (1)" />
      <!-- Costed situational verbs: hidden until their precondition holds,
           like the free ones below, but they still bill an action. -->
      <Button id="actStabilize"
              onClick="onActStabilize"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#C9B4A0FF" textColor="#12180F"
              active="false"
              text="Stabilize (1)" />
      <Button id="actDefend"
              onClick="onActDefend"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#A8C4DCFF" textColor="#12180F"
              active="false"
              text="Defend (1)" />
      <Button id="actBarricade"
              onClick="onActBarricade"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#B0A48CFF" textColor="#12180F"
              active="false"
              text="Barricade (1)" />
      <Button id="actAppease"
              onClick="onActAppease"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#9CC49CFF" textColor="#12180F"
              active="false"
              text="Appease (1)" />
      <Button id="actClear"
              onClick="onActClear"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#C4B49CFF" textColor="#12180F"
              active="false"
              text="Clear (1)" />
      </HorizontalLayout>
      <Text fontSize="18" color="#5A6656" alignment="MiddleCenter"
            preferredWidth="10" flexibleWidth="0" text="│" />
      <Text id="actGroupFreeLabel" fontSize="10" fontStyle="Bold"
            color="#8FC28F" alignment="MiddleCenter"
            preferredWidth="34" flexibleWidth="0"
            text="FREE" />
      <HorizontalLayout id="actGroupFree" spacing="8"
                        childForceExpandWidth="true" flexibleWidth="5">
      <!-- Trade lives here because its headline case is free: once per turn
           at your own tile. Reaching an ally on another tile costs an action,
           and the trade dialog says so per partner. -->
      <Button id="actTrade"
              onClick="onActTrade"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#B2C2D4FF" textColor="#12180F"
              text="Trade" />
      <Button id="actSignature"
              onClick="onActSignature"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#CBB6D2FF" textColor="#12180F"
              text="Signature" />
      <!-- Per-character perk buttons: Lua shows exactly one of these, and
           only for the matching character (refreshActionButtonStates). -->
      <Button id="actPeek"
              onClick="onActPeek"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#B2C2D4FF" textColor="#12180F"
              active="false"
              text="Peek" />
      <Button id="actRally"
              onClick="onActRally"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#D6B9C6FF" textColor="#12180F"
              active="false"
              text="Rally" />
      <Button id="actPry"
              onClick="onActPry"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#DCCB9EFF" textColor="#12180F"
              text="Pry" />
      <!-- Situational verbs (ui_actionbar_situational.lua): each is hidden
           until its precondition holds, the same way Peek and Rally are.
           They are the rules that had no button — Revive was the worst of
           them, since Telltale Hearts could be cooked but never spent. -->
      <Button id="actRevive"
              onClick="onActRevive"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#C9A0DCFF" textColor="#12180F"
              active="false"
              text="Revive" />
      <Button id="actEnergy"
              onClick="onActEnergyDrink"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#E8D66AFF" textColor="#12180F"
              active="false"
              text="Energy Drink" />
      <Button id="actEatUncooked"
              onClick="onActEatUncooked"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#D2B48CFF" textColor="#12180F"
              active="false"
              text="Eat Uncooked" />
      <Button id="actUseItem"
              onClick="onActUseItem"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#DCC864FF" textColor="#12180F"
              active="false"
              text="Use Item" />
      <Button id="actFlee"
              onClick="onActFlee"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#DCA0A0FF" textColor="#12180F"
              active="false"
              text="Flee" />
      <Button id="actUndo"
              onClick="onActUndo"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#D3C7A2FF" textColor="#12180F"
              text="Undo" />
      <Button id="actPass"
              onClick="onActPass"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#E0C89AFF" textColor="#12180F"
              text="End Turn" />
      </HorizontalLayout>
    </HorizontalLayout>
    <!-- Action Cubes Row -->
    <HorizontalLayout spacing="6" childForceExpandWidth="false"
                      childAlignment="MiddleCenter"
                      preferredHeight="30">
      <!-- Whose bar this is, said at the bar. The banner names the character
           and the seat, TTS's player list names the human, and TTS's own turn
           plate names a third thing — a real player reported being "baffled
           whose turn it is, player or character". This is the panel they are
           actually clicking, so it answers it here: "Rayman (Green seat)".
           Set by refreshActionBar (ui_actionbar_display.lua). -->
      <Text id="actBarWho" fontSize="14" fontStyle="Bold" color="#CFE0CF"
            alignment="MiddleRight" preferredWidth="230" text="" />
      <Text fontSize="13" color="#889988" text="Actions:" preferredWidth="65" />
      <Text id="cube1" fontSize="20" color="#66FF66" text="■" preferredWidth="28" />
      <Text id="cube2" fontSize="20" color="#66FF66" text="■" preferredWidth="28" />
      <Text id="cube3" fontSize="20" color="#66FF66" text="■" preferredWidth="28" />
      <Text id="cubeLabel" fontSize="13" color="#889988" text="3 remaining"
            preferredWidth="100" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- REACTIONS — free things you can do on SOMEBODY ELSE'S turn.        -->
<!--                                                                    -->
<!-- The Action Bar is one shared panel gated to the active player, so   -->
<!-- it cannot host an off-turn move: a non-active player's click is     -->
<!-- rejected by validateActivePlayer, and a button's enabled state is   -->
<!-- global rather than per-seat. This panel is the home for reactions   -->
<!-- instead. Each row NAMES its actor ("Rayman: ...") and the handler   -->
<!-- checks that the clicking player is that actor, which is what makes  -->
<!-- a shared panel safe.                                               -->
<!--                                                                    -->
<!-- Two reactions live here (Design §10.1, §6.5): Witness — pay 1       -->
<!-- Sanity to see an ally's Haunted threat and fight it with them; and  -->
<!-- Luca's Rally, which fires on the recipient's own turn so Luca is    -->
<!-- always partly engaged (§11.2 downtime relief).                     -->
<!-- Refreshed by refreshReactionsPanel() in ui_reactions.lua.           -->
<!-- ================================================================== -->
<Panel id="reactionsPanel"
       rectAlignment="LowerRight"
       offsetXY="-10 130"
       width="330" height="150"
       color="#0A0814EE"
       outline="#8878C87F"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="4" padding="10 10 8 8"
                  childForceExpandHeight="false">
    <Text fontSize="13" fontStyle="Bold" color="#CCC0FF"
