<!-- hud.xml — persistent HUD: Phase Banner, day-cycle strip, Dawn checklist,
     Host Controls, Rules-in-effect panel, Action Bar, stat display, roster. -->
<!-- TTS XML UI reference: position is in screen-space pixels from center. -->

<!-- ================================================================== -->
<!-- G.1  PHASE BANNER — persistent top-of-screen status bar            -->
<!-- Design §18.11: Day / Phase / Doom / Active player / Next action    -->
<!-- ================================================================== -->
<Panel id="phaseBanner"
       rectAlignment="UpperCenter"
       offsetXY="0 -42"
       width="1470" height="64"
       color="#000000BF"
       outline="#50B4DC66"
       outlineSize="1"
       active="true">
  <HorizontalLayout spacing="12" padding="8 14 8 14"
                    childForceExpandWidth="false"
                    childAlignment="MiddleCenter">
    <!-- Day -->
    <Text id="bannerDay"
          fontSize="20" fontStyle="Bold"
          color="#88DDFF"
          preferredWidth="130"
          text="Day 1 of 7" />
    <!-- Separator -->
    <Text fontSize="18" color="#445566" text="|" preferredWidth="10" />
    <!-- Phase -->
    <Text id="bannerPhase"
          fontSize="18"
          color="#AACCDD"
          preferredWidth="220"
          text="Dusk of the Week" />
    <!-- Separator -->
    <Text fontSize="18" color="#445566" text="|" preferredWidth="10" />
    <!-- Doom -->
    <Text id="bannerDoom"
          fontSize="20" fontStyle="Bold"
          color="#FFDD66"
          preferredWidth="200"
          text="Doom 0 / 30" />
    <!-- Separator -->
    <Text fontSize="18" color="#445566" text="|" preferredWidth="10" />
    <!-- Active Player -->
    <Text id="bannerActive"
          fontSize="18"
          color="#FFFFFF"
          preferredWidth="180"
          text="— pre-game —" />
    <!-- Separator -->
    <Text fontSize="18" color="#445566" text="|" preferredWidth="10" />
    <!-- Next Action -->
    <Text id="bannerNext"
          fontSize="17" fontStyle="Italic"
          color="#BBDDBB"
          preferredWidth="300"
          text="Click Setup to begin" />
    <!-- Help button -->
    <Button id="helpBtn"
            onClick="onHelpClick"
            fontSize="22" fontStyle="Bold"
            color="#285064E6"
            textColor="#88EEFF"
            preferredWidth="44" preferredHeight="44"
            text="?" />
    <!-- What now? button -->
    <Button id="hintBtn"
            onClick="onWhatNowClick"
            fontSize="14"
            color="#28503CE6"
            textColor="#BBFFBB"
            preferredWidth="100" preferredHeight="44"
            text="What now?" />
    <!-- Message Log toggle -->
    <Button id="logBtn"
            onClick="onMsgLogToggle"
            fontSize="14"
            color="#28323CE6"
            textColor="#BBDDFF"
            preferredWidth="60" preferredHeight="44"
            tooltip="Show or hide the Message Log — every game message stays there until you clear it."
            tooltipPosition="Below" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF"
            text="Log" />
  </HorizontalLayout>
</Panel>

<!-- ================================================================== -->
<!-- UI TOGGLE — always visible; hides/shows every custom panel so the  -->
<!-- default TTS controls underneath stay reachable (onToggleCustomUI). -->
<!-- ================================================================== -->
<Button id="uiToggle"
        rectAlignment="UpperRight"
        offsetXY="-10 -84"
        width="88" height="26"
        onClick="onToggleCustomUI"
        fontSize="12"
        color="#282828E6" textColor="#CCCCCC"
        tooltip="Hide or show all of this game's panels, so the standard Tabletop Simulator controls underneath are easy to reach."
        tooltipPosition="Left" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF"
        text="Hide UI" />

<!-- ================================================================== -->
<!-- DAY-CYCLE STRIP — Dawn ▸ Day ▸ Dusk ▸ Night ▸ Tick, current lit    -->
<!-- Updated by refreshCycleStrip() in ui_rules.lua                     -->
<!-- ================================================================== -->
<Panel id="cycleStrip"
       rectAlignment="UpperCenter"
       offsetXY="0 -108"
       width="640" height="24"
       color="#00000099"
       active="false"
       tooltip="The day cycle. Dawn: the world acts first. Day: your 3 actions. Dusk: last scramble. Night: threats + sleep. Tick: stat decay. The lit step is where you are now.">
  <Text id="cycleText"
        fontSize="13"
        alignment="MiddleCenter"
        text="" />
</Panel>

<!-- ================================================================== -->
<!-- DAWN CHECKLIST — manual steps of the current Dawn card, tickable   -->
<!-- by any player. Populated by refreshDawnChecklist (ui_rules.lua);   -->
<!-- hides itself when every step is done.                              -->
<!-- ================================================================== -->
<Panel id="dawnChecklist"
       rectAlignment="UpperRight"
       offsetXY="-10 -122"
       width="400" height="180"
       color="#140C04E0"
       outline="#F0C87873"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="4" padding="10 10 8 8"
                  childForceExpandHeight="false">
    <Text fontSize="14" fontStyle="Bold" color="#FFD080"
          text="Dawn card — do these now (click to tick off):"
          preferredHeight="20" />
    <Button id="dawnStep_1" onClick="onDawnStepClick(1)" active="false"
            fontSize="12" color="#281C0CE6" textColor="#EEDDBB"
            alignment="MiddleLeft" preferredHeight="38" text="" />
    <Button id="dawnStep_2" onClick="onDawnStepClick(2)" active="false"
            fontSize="12" color="#281C0CE6" textColor="#EEDDBB"
            alignment="MiddleLeft" preferredHeight="38" text="" />
    <Button id="dawnStep_3" onClick="onDawnStepClick(3)" active="false"
            fontSize="12" color="#281C0CE6" textColor="#EEDDBB"
            alignment="MiddleLeft" preferredHeight="38" text="" />
    <Button id="dawnStep_4" onClick="onDawnStepClick(4)" active="false"
            fontSize="12" color="#281C0CE6" textColor="#EEDDBB"
            alignment="MiddleLeft" preferredHeight="38" text="" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- G.10  HOST CONTROL PANEL — phase advance buttons (host-only)       -->
<!-- Draggable: starts right of the TTS chat/menu corner, under the     -->
<!-- Phase Banner; players can drag it anywhere it isn't in the way.    -->
<!-- ================================================================== -->
<Panel id="hostControls"
       rectAlignment="UpperLeft"
       offsetXY="360 -150"
       width="200" height="310"
       color="#000000B2"
       outline="#FFC8644C"
       outlineSize="1"
       allowDragging="true"
       returnToOriginalPositionWhenReleased="false"
       active="true">
  <VerticalLayout spacing="6" padding="8 8 8 8"
                  childForceExpandHeight="false">
    <Text fontSize="14" fontStyle="Bold" color="#FFD080"
          text="Host Controls" preferredHeight="22" />
    <Button id="btnSetup"
            onClick="onHostSetupGuided"
            fontSize="15" color="#2F7D34FF" textColor="#EAFFEA"
            preferredHeight="38"
            text="Setup Game" />
    <Button id="btnBeginDay"
            onClick="onHostBeginDay"
            fontSize="15" color="#1E6DB0FF" textColor="#EAF6FF"
            preferredHeight="38"
            text="Begin Day" />
    <Button id="btnResolveNight"
            onClick="onHostResolveNight"
            fontSize="15" color="#3B4694FF" textColor="#EAEEFF"
            preferredHeight="38"
            text="Resolve Night" />
    <Button id="btnEndTurn"
            onClick="onHostEndTurn"
            fontSize="15" color="#9A7A1EFF" textColor="#FFF7E0"
            preferredHeight="38"
            text="End Turn / Pass" />
    <Button id="btnRestart"
            onClick="onHostRestart"
            fontSize="15" color="#A23A3AFF" textColor="#FFEAEA"
            preferredHeight="38"
            text="Restart" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- RULES IN EFFECT — persistent list of every rule currently          -->
<!-- modifying play: sub-phase rules, Doom thresholds, ongoing Dawn     -->
<!-- effects, bosses, character statuses. ui_rules.lua refreshes it on  -->
<!-- every state change and sizes the panel to its content.             -->
<!-- ================================================================== -->
<!-- Anchored on the left BELOW the character box (statDisplay, MiddleLeft)
     rather than LowerLeft, where it sat on top of the TTS game-log/chat. -->
<Panel id="rulesPanel"
       rectAlignment="MiddleLeft"
       offsetXY="10 -240"
       width="230" height="120"
       color="#000000B2"
       outline="#78C8A059"
       outlineSize="1"
       active="false">
  <VerticalLayout spacing="4" padding="8 8 6 6"
                  childForceExpandHeight="false">
    <HorizontalLayout spacing="4" preferredHeight="22">
      <Text fontSize="13" fontStyle="Bold" color="#A8E6C8"
            text="Rules in effect" />
      <Button id="rulesToggle"
              onClick="onRulesToggle"
              fontSize="12" color="#1E3228E6" textColor="#A8E6C8"
              preferredWidth="24" preferredHeight="18"
              tooltip="Collapse / expand this panel."
              text="–" />
    </HorizontalLayout>
    <Text id="rulesBody" fontSize="11" color="#CCDDCC"
          alignment="UpperLeft"
          text="" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- G.3  ACTION BAR — per-player action buttons (bottom of screen)     -->
<!-- Design §18.13: 7 action buttons + 3 cubes                         -->
<!-- Visibility set dynamically by Lua to the active player only        -->
<!-- ================================================================== -->
<Panel id="actionBar"
       rectAlignment="LowerCenter"
       offsetXY="0 10"
       width="1100" height="110"
       color="#000000BF"
       outline="#64B4644C"
       outlineSize="1"
       active="false">
  <!-- Button help lives in ACTION_TOOLTIPS (ui_actionbar.lua), shown in the
       actionTooltip panel above the bar after a hover delay — not in native
       tooltip attributes (those render instantly, transparent, on the bar). -->
  <VerticalLayout spacing="4" padding="6 10 6 10">
    <!-- Action Buttons Row -->
    <HorizontalLayout spacing="8" childForceExpandWidth="true"
                      preferredHeight="52">
      <Button id="actMove"
              onClick="onActMove"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#1E3228E6" textColor="#CCFFCC"
              text="Move (1)" />
      <Button id="actGather"
              onClick="onActGather"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#1E3228E6" textColor="#CCFFCC"
              text="Gather (1)" />
      <Button id="actCraft"
              onClick="onActCraft"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#1E3228E6" textColor="#CCFFCC"
              text="Craft (1)" />
      <Button id="actCook"
              onClick="onActCook"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#1E3228E6" textColor="#CCFFCC"
              text="Cook (1)" />
      <Button id="actFight"
              onClick="onActFight"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#1E3228E6" textColor="#CCFFCC"
              text="Fight (1)" />
      <Button id="actRest"
              onClick="onActRest"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#1E3228E6" textColor="#CCFFCC"
              text="Rest (1)" />
      <Button id="actCleanse"
              onClick="onActCleanse"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#1E3228E6" textColor="#CCFFCC"
              text="Cleanse (1)" />
      <Button id="actTrade"
              onClick="onActTrade"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#1E2837E6" textColor="#CCE5FF"
              text="Trade" />
      <Button id="actSignature"
              onClick="onActSignature"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#37233CE6" textColor="#EECCFF"
              text="Signature" />
      <!-- Per-character perk buttons: Lua shows exactly one of these, and
           only for the matching character (refreshActionButtonStates). -->
      <Button id="actPeek"
              onClick="onActPeek"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#1E2837E6" textColor="#CCE5FF"
              active="false"
              text="Peek" />
      <Button id="actRally"
              onClick="onActRally"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#2D1E28E6" textColor="#FFCCE5"
              active="false"
              text="Rally" />
      <Button id="actPry"
              onClick="onActPry"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#322A19E6" textColor="#FFE8AA"
              text="Pry" />
      <Button id="actUndo"
              onClick="onActUndo"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#2D2819E6" textColor="#EEDDAA"
              text="Undo" />
      <Button id="actPass"
              onClick="onActPass"
              onMouseEnter="onActionTooltipEnter" onMouseExit="onActionTooltipExit"
              fontSize="14" color="#32281EE6" textColor="#FFDDAA"
              text="Pass" />
    </HorizontalLayout>
    <!-- Action Cubes Row -->
    <HorizontalLayout spacing="6" childForceExpandWidth="false"
                      childAlignment="MiddleCenter"
                      preferredHeight="30">
      <Text fontSize="13" color="#889988" text="Actions:" preferredWidth="65" />
      <Text id="cube1" fontSize="20" color="#66FF66" text="■" preferredWidth="28" />
      <Text id="cube2" fontSize="20" color="#66FF66" text="■" preferredWidth="28" />
      <Text id="cube3" fontSize="20" color="#66FF66" text="■" preferredWidth="28" />
      <Text id="cubeLabel" fontSize="13" color="#889988" text="3 remaining"
            preferredWidth="100" />
    </HorizontalLayout>
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- ACTION TOOLTIP — custom help strip for the action buttons. Sits    -->
<!-- just ABOVE the action bar, fully opaque, and appears only after    -->
<!-- a hover delay (onActionTooltipEnter/Exit in ui_actionbar.lua).     -->
<!-- ================================================================== -->
<Panel id="actionTooltip"
       rectAlignment="LowerCenter"
       offsetXY="0 126"
       width="920" height="72"
       color="#0A140AFF"
       outline="#64B464CC"
       outlineSize="1"
       active="false">
  <Text id="actionTooltipText"
        fontSize="14" color="#EEFFEE"
        alignment="MiddleCenter"
        text="" />
</Panel>

<!-- ================================================================== -->
<!-- G.5  STAT DISPLAY — shows active player's stats (left side)        -->
<!-- Updated dynamically by Lua                                         -->
<!-- ================================================================== -->
<Panel id="statDisplay"
       rectAlignment="MiddleLeft"
       offsetXY="10 0"
       width="180" height="298"
       color="#000000B2"
       outline="#9696964C"
       outlineSize="1"
       active="false">
  <VerticalLayout spacing="4" padding="8 8 8 8"
                  childForceExpandHeight="false">
    <Text id="statCharName" fontSize="16" fontStyle="Bold" color="#FFFFFF"
          text="—" preferredHeight="22" />

    <!-- Health -->
    <HorizontalLayout spacing="4" preferredHeight="28">
      <Text fontSize="14" color="#FF6666" text="HP" preferredWidth="28"
            tooltip="Health — physical damage. At 0 you go Down (a ghost) until revived with a Telltale Heart. Below 3: Move costs +1 action."
            tooltipPosition="Right" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF" />
      <ProgressBar id="statHealthBar" percentage="100"
                   fillImageColor="#FF4444" color="#EFEFEFFF"
                   preferredWidth="100" />
      <Text id="statHealthVal" fontSize="14" color="#FF8888" text="8/8"
            preferredWidth="40" />
    </HorizontalLayout>

    <!-- Hunger -->
    <HorizontalLayout spacing="4" preferredHeight="28">
      <Text fontSize="14" color="#FFAA44" text="HU" preferredWidth="28"
            tooltip="Hunger — your stomach. It drops every night at Tick; at 0 you lose Health instead. Below 3: you cannot Fight (you may always Flee). Eat food or Rest to refill."
            tooltipPosition="Right" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF" />
      <ProgressBar id="statHungerBar" percentage="100"
                   fillImageColor="#FFAA22" color="#EFEFEFFF"
                   preferredWidth="100" />
      <Text id="statHungerVal" fontSize="14" color="#FFCC66" text="6/6"
            preferredWidth="40" />
    </HorizontalLayout>

    <!-- Sanity -->
    <HorizontalLayout spacing="4" preferredHeight="28">
      <Text fontSize="14" color="#66BBFF" text="SA" preferredWidth="28"
            tooltip="Sanity — your mind. Drained by darkness, isolation and weird events. At 0 you go Down (lost). Below 3: Haunted — each Dawn a Threat appears at your tile that only you can face."
            tooltipPosition="Right" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF" />
      <ProgressBar id="statSanityBar" percentage="100"
                   fillImageColor="#4488FF" color="#EFEFEFFF"
                   preferredWidth="100" />
      <Text id="statSanityVal" fontSize="14" color="#88CCFF" text="10/10"
            preferredWidth="40" />
    </HorizontalLayout>

    <!-- Location -->
    <Text id="statLocation" fontSize="12" color="#AAAAAA"
          text="Location: —" preferredHeight="20" />

    <!-- Live resource counts (tokens beside your player board) -->
    <Text id="statResources" fontSize="11" color="#CCC8A0"
          alignment="UpperLeft"
          tooltip="Your resource tokens, counted live. They physically sit beside your player board."
          tooltipPosition="Right" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF"
          text="" preferredHeight="32" />

    <!-- Perks + constraint, always visible (briefing shows only once) -->
    <!-- No manual +/- stat buttons here: every stat change is automated
         by the action/night/tick handlers. -->
    <Text id="statPerks" fontSize="10" color="#99BBAA"
          alignment="UpperLeft"
          text="" preferredHeight="66" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- CHAR ROSTER — all 5 characters' stats at a glance (right side)     -->
<!-- Design §10.2: any player can glance at any character's state.      -->
<!-- Updated dynamically by refreshCharRoster() in ui_banner.lua.       -->
