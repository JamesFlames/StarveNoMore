        alignment="MiddleCenter"
        text="" />
</Panel>

<!-- ================================================================== -->
<!-- G.5  STAT DISPLAY — shows active player's stats (left side)        -->
<!-- Updated dynamically by Lua                                         -->
<!-- ================================================================== -->
<Panel id="statDisplay"
       rectAlignment="MiddleLeft"
       offsetXY="10 0"
       width="180" height="320"
       color="#000000B2"
       outline="#9696964C"
       outlineSize="1"
       active="false">
  <VerticalLayout spacing="4" padding="8 8 8 8"
                  childForceExpandHeight="false">
    <!-- Title row + collapse. This panel is MiddleLeft and the Rules-in-effect
         panel sits directly under it, so a full-height stat box buries the
         rules a player is trying to read. Same affordance as rulesToggle, same
         handler shape (onStatToggle, ui_actionbar_display.lua). -->
    <HorizontalLayout spacing="4" preferredHeight="22">
      <Text id="statCharName" fontSize="16" fontStyle="Bold" color="#FFFFFF"
            text="—" />
      <Button id="statToggle"
              onClick="onStatToggle"
              fontSize="12" color="#28323CE6" textColor="#BBDDFF"
              preferredWidth="24"
              tooltip="Collapse / expand this panel — the Rules in effect are underneath it."
              text="–" />
    </HorizontalLayout>
    <!-- Who is playing this character. The single most-asked question at a
         real table was "who is what character", because the game names
         characters everywhere and TTS names humans everywhere and nothing
         joined the two up. Set by refreshStatDisplay. -->
    <Text id="statPlayerName" fontSize="12" fontStyle="Italic" color="#A8B8C8"
          text="" preferredHeight="16" />
    <!-- Everything below here is hidden while the panel is collapsed. -->

    <!-- Health -->
    <HorizontalLayout id="statRowHP" spacing="4" preferredHeight="28">
      <Text fontSize="14" color="#FF6666" text="HP" preferredWidth="28"
            tooltip="Health — physical damage. At 0 you go Down (a ghost) until&#10;revived with a Telltale Heart. Below 3: Move costs +1 action."
            tooltipPosition="Right" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF" />
      <ProgressBar id="statHealthBar" percentage="100"
                   fillImageColor="#FF4444" color="#EFEFEFFF"
                   preferredWidth="100" />
      <Text id="statHealthVal" fontSize="14" color="#FF8888" text="8/8"
            preferredWidth="40" />
    </HorizontalLayout>

    <!-- Hunger -->
    <HorizontalLayout id="statRowHU" spacing="4" preferredHeight="28">
      <Text fontSize="14" color="#FFAA44" text="HU" preferredWidth="28"
            tooltip="Hunger — your stomach. It drops every night at Tick; at 0 you&#10;lose Health instead. Below 3: you cannot Fight (you may always&#10;Flee). Eat food or Rest to refill."
            tooltipPosition="Right" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF" />
      <ProgressBar id="statHungerBar" percentage="100"
                   fillImageColor="#FFAA22" color="#EFEFEFFF"
                   preferredWidth="100" />
      <Text id="statHungerVal" fontSize="14" color="#FFCC66" text="6/6"
            preferredWidth="40" />
    </HorizontalLayout>

    <!-- Sanity -->
    <HorizontalLayout id="statRowSA" spacing="4" preferredHeight="28">
      <Text fontSize="14" color="#66BBFF" text="SA" preferredWidth="28"
            tooltip="Sanity — your mind. Drained by darkness, isolation and weird&#10;events. At 0 you go Down (lost). Below 3: Haunted — each Dawn&#10;a Threat appears at your tile that only you can face."
            tooltipPosition="Right" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF" />
      <ProgressBar id="statSanityBar" percentage="100"
                   fillImageColor="#4488FF" color="#EFEFEFFF"
                   preferredWidth="100" />
      <Text id="statSanityVal" fontSize="14" color="#88CCFF" text="10/10"
            preferredWidth="40" />
    </HorizontalLayout>

    <!-- Location -->
    <Text id="statLocation" fontSize="12" color="#AAAAAA"
          text="Location: —" preferredHeight="20" />

    <!-- Live resource counts (tokens beside your player board) -->
    <Text id="statResources" fontSize="11" color="#CCC8A0"
          alignment="UpperLeft"
          tooltip="Your resource tokens, counted live. They physically sit beside&#10;your player board."
          tooltipPosition="Right" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF"
          text="" preferredHeight="48" />

    <!-- Perks + constraint, always visible (briefing shows only once) -->
    <!-- No manual +/- stat buttons here: every stat change is automated
         by the action/night/tick handlers. -->
    <Text id="statPerks" fontSize="10" color="#99BBAA"
          alignment="UpperLeft"
          text="" preferredHeight="66" />
  </VerticalLayout>
</Panel>

