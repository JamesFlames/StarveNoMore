    <!-- == Paging == -->
    <HorizontalLayout spacing="10" childForceExpandWidth="true" preferredHeight="34">
      <Button id="achPrev" onClick="onAchievementsPrev"
              fontSize="14" color="#282828E6" textColor="#CCCCCC" text="&lt; Previous" />
      <Text id="achPageLabel" fontSize="13" color="#AA9977"
            alignment="MiddleCenter" text="Page 1 of 1" />
      <Button id="achNext" onClick="onAchievementsNext"
              fontSize="14" color="#282828E6" textColor="#CCCCCC" text="Next &gt;" />
    </HorizontalLayout>

    <!-- == Carrying the vault between tables == -->
    <HorizontalLayout spacing="10" childForceExpandWidth="false" preferredHeight="34">
      <Button id="achCopyCode" onClick="onAchievementsCopyCode"
              fontSize="13" color="#192837E6" textColor="#88CCEE"
              preferredWidth="180"
              tooltip="Write this table's achievement code to the Notes panel (top menu &gt; Notes). Copy it out and paste it into another table's box below to carry your unlocks over."
              text="Copy my code" />
      <InputField id="achCodeInput" onEndEdit="onAchievementsImportCode"
                  fontSize="12" preferredWidth="420"
                  colors="#101010E6|#181818E6|#202020E6|#101010E6"
                  textColor="#CCCCCC"
                  placeholder="Paste an achievement code here and press Enter" />
    </HorizontalLayout>

    <Button id="achievementsClose" onClick="onAchievementsClose"
            fontSize="15" color="#282828E6" textColor="#AAAAAA"
            preferredHeight="34" text="Close" />
  </VerticalLayout>
</Panel>

<!-- ================================================================== -->
<!-- UNLOCK TOAST — slides nothing, but appears bottom-right above the  -->
<!-- Message Log for a few seconds, the way Steam's does. One at a      -->
<!-- time; showAchievementToast queues the rest.                        -->
<!-- ================================================================== -->
<Panel id="achToast"
       rectAlignment="LowerRight"
       offsetXY="-10 400"
       width="400" height="88"
       color="#0B0906F2"
       outline="#F0C878B2"
       outlineSize="2"
       active="false">
  <HorizontalLayout spacing="10" padding="8 8 8 8" childForceExpandWidth="false">
    <Image id="achToastIcon" image="ach_locked" preferredWidth="64" preferredHeight="64" />
    <VerticalLayout preferredWidth="296" childForceExpandHeight="false">
      <Text fontSize="11" color="#F0C878" alignment="MiddleLeft"
            preferredHeight="18" text="ACHIEVEMENT UNLOCKED" />
      <Text id="achToastName" fontSize="15" fontStyle="Bold" color="#FFEECC"
            alignment="MiddleLeft" preferredHeight="22" text="" />
      <Text id="achToastDesc" fontSize="11" color="#AA9977"
            alignment="UpperLeft" preferredHeight="26" text="" />
    </VerticalLayout>
  </HorizontalLayout>
</Panel>
