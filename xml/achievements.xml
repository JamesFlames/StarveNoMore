<!-- achievements.xml — the Achievements panel and the unlock toast.
     Populated by lua/ui_achievements.lua; the roster itself is generated
     into lua/achievement_data.lua from content/achievements.csv.

     Paged, not scrolled, for the same reason the Help panel is: a TTS Text
     clips silently — no scrollbar, no ellipsis, no warning — so anything past
     the visible rows would simply not exist. Eight rows a page, and the nav
     row reports which page you are on.

     Every icon is a CustomUIAssets entry (ach_<id>) emitted by
     scripts/build_save.py; the XML ships the locked placeholder and the Lua
     swaps in the real one row by row. A locked row keeps its silhouette but
     is tinted down rather than replaced, so the shape of what you have not
     done yet is still on the wall. -->

<!-- ================================================================== -->
<!-- ACHIEVEMENTS BUTTON — sits beside the Hide UI toggle, top right    -->
<!-- ================================================================== -->
<Button id="achievementsBtn"
        rectAlignment="UpperRight"
        offsetXY="-104 -84"
        width="100" height="26"
        onClick="onAchievementsClick"
        fontSize="12"
        color="#2A2418E6" textColor="#F0D89A"
        tooltip="Achievements — what this table has done across every game it has played. Kept when you Restart; carried to another table with the code at the bottom of the panel."
        tooltipPosition="Left" tooltipBackgroundColor="#000000FF" tooltipTextColor="#FFFFFF"
        text="Trophies" />

<!-- ================================================================== -->
<!-- ACHIEVEMENTS PANEL                                                 -->
<!-- ================================================================== -->
<Panel id="achievementsPanel"
       rectAlignment="MiddleCenter"
       width="780" height="700"
       color="#08070AF7"
       outline="#DCB45A8C"
       outlineSize="2"
       active="false">
  <VerticalLayout spacing="6" padding="14 14 12 12"
                  childForceExpandHeight="false">

    <Text id="achievementsTitle" fontSize="22" fontStyle="Bold" color="#FFD080"
          text="ACHIEVEMENTS" preferredHeight="30" />
    <Text id="achievementsProgress" fontSize="14" color="#AA9977"
          text="0 of 0 unlocked" preferredHeight="22" />

    <!-- == Row 1 == -->
    <Panel id="achRow_1" preferredHeight="54" color="#14121080">
      <HorizontalLayout spacing="10" padding="4 6 4 4" childForceExpandWidth="false">
        <Image id="achIcon_1" image="ach_locked" preferredWidth="46" preferredHeight="46" />
        <VerticalLayout preferredWidth="540" childForceExpandHeight="false">
          <Text id="achName_1" fontSize="15" fontStyle="Bold" color="#EEDDBB"
                alignment="MiddleLeft" preferredHeight="22" text="" />
          <Text id="achDesc_1" fontSize="12" color="#998877"
                alignment="UpperLeft" preferredHeight="24" text="" />
        </VerticalLayout>
        <Text id="achStatus_1" fontSize="12" color="#776655"
              alignment="MiddleRight" preferredWidth="120" text="" />
      </HorizontalLayout>
    </Panel>

    <!-- == Row 2 == -->
